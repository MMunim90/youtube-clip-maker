{
  "manifest_version": 3,
  "name": "YouTube Clip Maker",
  "version": "1.0.0",
  "description": "Record selected portions of browser tab playback.",

  "permissions": ["activeTab", "tabs", "downloads"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": ["libs/ffmpeg/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
